{
  "name": "simplecov-report",
  "version": "2.0.0",
  "private": true,
  "description": "Simplecov Report",
  "main": "src/main.js",
  "scripts": {
    "prepare": "husky",
    "pack": "ncc build src/main.js -o dist --license licenses.txt",
    "test": "node --test test/*.test.js",
    "all": "npm run test && npm run pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeur/simplecov-report-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "codeur",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "husky": "^9.1.7"
  }
}
